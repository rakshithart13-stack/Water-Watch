# Water Watch AI — Environment Configuration Template
# Duplicate this file to .env and adjust variables as required

APP_ENV=development
APP_NAME="Water Watch AI"
DATABASE_URL="sqlite:///./water_watch.db"

# Optional Cloud Persistence (Supabase / Render PostgreSQL)
# When SUPABASE_URL is provided, schema migrations in /supabase/migrations/ can be applied
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-or-service-key-here"

# Multi-Source Priority Model Weights (Total sum = 1.0)
WEIGHT_SEVERITY=0.35
WEIGHT_ANOMALY=0.25
WEIGHT_CORROBORATION=0.25
WEIGHT_AGE=0.15
PENALTY_UNRELIABLE_DATA=0.30

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","*"]
